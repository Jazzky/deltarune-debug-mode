function scr_debug_save_modify_info(arg0, arg1)
{
	var _file = arg0;
	var update_lst = arg1;

    if (!file_exists(_file))
    {
        scr_debug_print(dstr(
			"Error: Save file not found on disk.",
			"Erreur : Fichier de sauvegarde introuvable"
		));
        return "";
    }
    
	var _json = dsaves_get_file_info(_file);
    
	for (var i = 0; i < array_length(update_lst); i++)
	{
		var ini_key = update_lst[i][0];
		var ini_value = update_lst[i][1];

		variable_struct_set(_json.metadata, ini_key, ini_value);
		scr_debug_print(
			dstr("Updated ", "Mise à jour de ") + ini_key +
			dstr(" to: ", " à : ") + string(ini_value)
		);
	}

	dutils_write_file(_file, json_stringify(_json));
    snd_play(snd_save);
}
