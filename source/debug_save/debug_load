function scr_debug_load(arg0, arg1=false)
{
    var file = string(arg0);
	var keep_inv = arg1;

	var option_flags = [8, 11, 15, 16, 17, 25, 1391];
	var nb_cached_options = array_length(option_flags);
	var cache_option_flags = [];
	for (var i = 0; i < nb_cached_options; i++)
    {
		_cur_flag = option_flags[i];
		cache_option_flags[_cur_flag] = global.flag[_cur_flag];
    }
	
    var cache_charweapon = darray_copy_all(global.charweapon);
    var cache_chararmor1 = darray_copy_all(global.chararmor1);
    var cache_chararmor2 = darray_copy_all(global.chararmor2);
    var cache_weaponstyle = darray_copy_all(global.weaponstyle);
    var cache_item = darray_copy_all(global.item);
    var cache_keyitem = darray_copy_all(global.keyitem);
    var cache_weapon = darray_copy_all(global.weapon);
    var cache_armor = darray_copy_all(global.armor);
	if (global.chapter != 1)
		var cache_pocketitem = darray_copy_all(global.pocketitem);
    
	scr_load(file);

	for (var i = 0; i < nb_cached_options; i++)
    {
		_cur_flag = option_flags[i];
		global.flag[_cur_flag] = cache_option_flags[_cur_flag];
    }

    if (!keep_inv)
		exit;

    global.charweapon = darray_copy_all(cache_charweapon);
    global.chararmor1 = darray_copy_all(cache_chararmor1);
    global.chararmor2 = darray_copy_all(cache_chararmor2);
    global.weaponstyle = darray_copy_all(cache_weaponstyle);
    global.item = darray_copy_all(cache_item);
    global.keyitem = darray_copy_all(cache_keyitem);
    global.weapon = darray_copy_all(cache_weapon);
    global.armor = darray_copy_all(cache_armor);
	if (global.chapter != 1)
		global.pocketitem = darray_copy_all(cache_pocketitem);
}
