if (scr_debug())
{
    if (mouse_check_button_pressed(mb_middle))
        instance_create(0, 0, obj_debug_xy);

    if (keyboard_check_pressed(192))
    {
        if (room_speed == 30)
        {
            room_speed = 150 - (140 * keyboard_check(vk_control));
        }
        else
        {
            room_speed = 30;
        }
    }
}
