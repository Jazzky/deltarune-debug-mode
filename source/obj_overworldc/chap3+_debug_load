if (scr_debug())
{
    if (sunkus_kb_check_pressed(ord("L")) && keyboard_check(vk_alt))
    {
        with (obj_dmenu_system)
            script_execute(scr_get_debug_save_list);

		dmenu_launch_state("debug_save");
